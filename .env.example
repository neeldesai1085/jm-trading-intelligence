# Database
DATABASE_URL=sqlite:///./jm_trading.db

# Market data (Yahoo Finance; no broker account or API key required)
BENCHMARK_ISIN=
BENCHMARK_YAHOO_SYMBOL=^NSEI
QUOTE_REFRESH_SECONDS=60

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=../data/incoming
RATE_LIMIT_PER_MINUTE=30

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
AUTH_ACCESS_MINUTES=20
AUTH_REFRESH_DAYS=30
AUTH_COOKIE_NAME=jmti_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
PASSWORD_RESET_MINUTES=30

# Optional SMTP for verification/reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional raw PDF archive
OBJECT_STORAGE_PROVIDER=local
STORE_RAW_PDF=false
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
